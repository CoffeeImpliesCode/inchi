# .envrc — direnv entry point for the canonical development interface.
# SPDX-License-Identifier: LicenseRef-InChI-MIT-Conditional
#
# The form devenv itself writes for a 2.x project, and the form already
# exercised on this host. No URL with a revision is embedded: `devenv` is
# resolved from PATH. Canonical entry is `devenv shell`; `nix develop` through
# flake.nix is the off-workspace alternative. Neither builds this SDK to give
# you a shell.

export DIRENV_WARN_TIMEOUT=20s

eval "$(devenv direnvrc)"

use devenv