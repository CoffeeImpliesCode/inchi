// SPDX-License-Identifier: LicenseRef-InChI-MIT-Conditional
// See FORK-LICENSE.md for grant terms.

.{
    .name = .inchi,
    // Upstream 1.07.5 is represented as Zig semantic version 1.7.5.
    .version = "1.7.5",
    .fingerprint = 0x5a222f3bcf2e0653, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        // C translation wrapper for the public API.
        "translate.h",
        // Upstream source trees used by the library build.
        "INCHI-1-SRC/INCHI_BASE/src",
        "INCHI-1-SRC/INCHI_API/libinchi/src",
        // Upstream's ELF export list for shared libraries.
        "INCHI-1-SRC/INCHI_API/libinchi/gcc/libinchi.map",
        // Apache-2.0 terms for the uncompiled TBB proxy header.
        "INCHI-1-SRC/INCHI_API/tbb/LICENSE",
        "zig",
        // Runtime sources are required at configure time and by runtime tests.
        "runtime",
        "tests.zig",
        "smoke.zig",
        // cross-test settings profile.
        "cross-test.profile.sh",
        // Embedded PubChem test oracle.
        "testdata",
        // Separate path-dependent consumer package.
        "consumer/build.zig",
        "consumer/build.zig.zon",
        "consumer/src/main.zig",
        // Licence and provenance records.
        "LICENSE",
        "FORK-LICENSE.md",
        "UPSTREAM.md",
        "UPSTREAM.sha256",
        "NOTICE.md",
        "CHANGELOG.md",
        "FORK-NOTES.md",
        "README.md",
        "README.upstream.md",
        "README.zig.md",
        // Nix package and development-environment definitions.
        "package.nix",
        "flake.nix",
        "flake.lock",
        "devenv.nix",
        "devenv.yaml",
        ".envrc",
    },
}
